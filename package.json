{
  "name": "@andrewheberle/ts-slog",
  "version": "1.3.0",
  "description": "Simple structured logger for TypeScript",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "lint": "eslint",
    "prepublishOnly": "npm run build",
    "release": "release-it",
		"release:ci": "npm run release:ci:patch",
		"release:ci:major": "release-it major --ci",
		"release:ci:minor": "release-it minor --ci",
		"release:ci:patch": "release-it patch --ci",
		"release:dryrun": "release-it --dry-run",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "logger",
    "logging",
    "typescript"
  ],
  "author": "Andrew Heberle (https://github.com/andrewheberle)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/andrewheberle/ts-slog/issues"
  },
  "homepage": "https://github.com/andrewheberle/ts-slog#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.2",
    "auto-changelog": "^2.5.1",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "release-it": "^20.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vitest": "^4.0.12"
  },
	"publishConfig": {
    "access": "public"
  },
  "release-it": {
		"git": {
			"requiredBranch": "main",
			"commitMessage": "chore(release): v${version}",
			"tagName": "v${version}",
			"requireCleanWorkingDir": false
		},
		"github": {
			"assets": [
				"sbom.spdx.json"
			],
			"autoGenerate": true,
			"release": true,
			"releaseName": "v${version}"
		},
		"hooks": {
			"after:bump": "npx auto-changelog -p"
		}
	},
	"npm": {
		"publish": true,
		"skipChecks": true
	}
}
